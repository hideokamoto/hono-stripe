{
  "name": "hono-stripe",
  "version": "0.1.0",
  "description": "All-in-one Stripe toolkit for Hono and HonoX — typed client middleware, verified + typed webhook routing with delivery dedupe, testing fixtures, and JSX payment UI. Works on Cloudflare Workers and Node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhook": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./billing": {
      "types": "./dist/billing/index.d.ts",
      "import": "./dist/billing/index.js",
      "require": "./dist/billing/index.cjs"
    },
    "./billing/schema": {
      "types": "./dist/billing/schema.d.ts",
      "import": "./dist/billing/schema.js",
      "require": "./dist/billing/schema.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "size:json": "size-limit --json",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:deploy": "pnpm -C docs deploy",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "hono",
    "honox",
    "stripe",
    "middleware",
    "payment",
    "cloudflare-workers",
    "edge",
    "webhook",
    "web-components",
    "payment-intent",
    "checkout",
    "testing"
  ],
  "author": "hideokamoto",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/hono-stripe.git"
  },
  "homepage": "https://github.com/hideokamoto/hono-stripe#readme",
  "bugs": {
    "url": "https://github.com/hideokamoto/hono-stripe/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "hono": ">=4",
    "stripe": ">=17"
  },
  "devDependencies": {
    "@size-limit/file": "^11.1.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.10.2",
    "better-sqlite3": "13.0.3",
    "hono": "^4.12.25",
    "size-limit": "^11.1.6",
    "stripe": "^22.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "stripe-decline-codes": "^0.2.0"
  }
}
